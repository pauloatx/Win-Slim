<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Win-Slim Suite"
        Width="1180" Height="760" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource ThemeBrush_080808}" AllowsTransparency="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="{DynamicResource ThemeBrush_F5F5F5}">
    <Window.Resources>
<Style x:Key="ThemeSwitch" TargetType="ToggleButton">
 <Setter Property="Width" Value="126"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E5E7EB}"/><Setter Property="FontSize" Value="11"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
  <Border x:Name="SwitchFocus" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="2"><Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="SwitchTrack" Width="38" Height="20" CornerRadius="10" Background="{DynamicResource ThemeBrush_42474D}" BorderBrush="{DynamicResource ThemeBrush_747B84}" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="SwitchThumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0"/></Border>
   <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
  </Grid><Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ThemeBrush_00C853}"/><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ThemeBrush_55DD91}"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ThemeBrush_55DD91}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchFocus" Property="BorderBrush" Value="{DynamicResource ThemeBrush_55DD91}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchFocus" Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
        <SolidColorBrush x:Key="Bg" Color="{DynamicResource ThemeColor_080808}"/>
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource ThemeColor_111111}"/>
        <SolidColorBrush x:Key="Panel2" Color="{DynamicResource ThemeColor_151515}"/>
        <SolidColorBrush x:Key="Panel3" Color="{DynamicResource ThemeColor_0D0D0D}"/>
        <SolidColorBrush x:Key="Border" Color="{DynamicResource ThemeColor_2A2A2A}"/>
        <SolidColorBrush x:Key="Orange" Color="{DynamicResource ThemeColor_FF7A00}"/>
        <SolidColorBrush x:Key="OrangeLight" Color="{DynamicResource ThemeColor_FF9A2E}"/>
        <SolidColorBrush x:Key="OrangeDark" Color="{DynamicResource ThemeColor_C85A00}"/>
        <SolidColorBrush x:Key="Muted" Color="{DynamicResource ThemeColor_A9AFB8}"/>
        <SolidColorBrush x:Key="Green" Color="{DynamicResource ThemeColor_14C767}"/>
        <SolidColorBrush x:Key="Red" Color="{DynamicResource ThemeColor_FF3152}"/>
        <SolidColorBrush x:Key="Amber" Color="{DynamicResource ThemeColor_FFC107}"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C8CDD5}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_202020}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_2A2A2A}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_C42B1C}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C7CCD4}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1"><Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_171717}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_23170D}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_FF7A00}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_FF8A18}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_C85A00}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_39BFC3}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="LinkBorder" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,2"><Grid>
                    <ContentPresenter/>
                <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeBrush_7CDADD}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_39BFC3}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_111111}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E7E9ED}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_3A3A3A}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_171717}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_21170E}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayChip" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_101215}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C8CDD5}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_343A42}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><Grid>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="15" Height="15" CornerRadius="8" BorderBrush="{DynamicResource ThemeBrush_737A84}" BorderThickness="2" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                            </Grid>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ThemeBrush_18130F}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ThemeBrush_4A2407}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighRiskChip" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_78591A}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_422B08}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_FFC107}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FFE08A}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="SmallCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E5E7EB}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FF7A00}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_202020}"/>
        </Style>

        <Style x:Key="BackupRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_0C0F10}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_F5F5F5}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="BackupRowBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ThemeBrush_242B30}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="{DynamicResource ThemeBrush_21170E}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="{DynamicResource ThemeBrush_3A1E0B}"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BackupRowBorder" Property="BorderThickness" Value="1"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    <Style x:Key="PresetAdvancedCheck" TargetType="CheckBox">
 <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E5E7EB}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,3"/><Setter Property="MinHeight" Value="16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
  <Grid x:Name="CheckRoot" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="CheckSquare" Width="12" Height="12" CornerRadius="2" Background="{DynamicResource ThemeBrush_101010}" BorderBrush="{DynamicResource ThemeBrush_737B85}" BorderThickness="1" VerticalAlignment="Center">
    <Grid><Path x:Name="CheckMark" Data="M 1,4 L 3.5,6.5 L 8,1.5" Stroke="{DynamicResource ThemeBrush_17100A}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle x:Name="MixedMark" Width="6" Height="2" Fill="{DynamicResource ThemeBrush_17100A}" Visibility="Collapsed"/></Grid>
   </Border>
   <ContentPresenter Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
  </Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSquare" Property="Background" Value="{DynamicResource ThemeBrush_FF7A00}"/><Setter TargetName="CheckSquare" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
   <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="CheckSquare" Property="Background" Value="{DynamicResource ThemeBrush_FF7A00}"/><Setter TargetName="MixedMark" Property="Visibility" Value="Visible"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSquare" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckRoot" Property="Background" Value="{DynamicResource ThemeBrush_25180D}"/><Setter TargetName="CheckSquare" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FFD4A6}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThemeBrush_8E949C}"/><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="CheckSquare" Property="Opacity" Value="0.65"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
</Window.Resources>

    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Grid Background="{DynamicResource ThemeBrush_080808}">
                <ContentPresenter x:Name="UnifiedContent" Margin="2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                <!-- Draw after every page, independent of its opaque background. -->
                <Border x:Name="UnifiedFrame" Margin="1" Panel.ZIndex="100" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="12" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
            </Grid>
        </ControlTemplate>
    </Window.Template>
    <Border BorderThickness="0" Background="{DynamicResource ThemeBrush_080808}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Compact native title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource ThemeBrush_090909}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path x:Name="ShellBrandMark" Data="F0 M34 2 C22 2 11 10 7 21 C9 21 12 20 15 18 C13 21 10 23 7 24 C7 28 8 31 11 33 C9 36 6 39 4 41 C3 42 5 44 6 43 C9 40 12 37 14 34 C20 33 25 29 29 23 C26 24 23 25 20 25 C24 23 28 21 31 18 C33 13 34 7 34 2 Z M11 33 C15 23 23 13 30 7 C24 15 18 25 13 34 Z" Fill="{DynamicResource ThemeAccent}" Width="22" Height="28" Stretch="Uniform" Margin="0,0,9,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Win-Slim Suite" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeTintText}"/>
                        <TextBlock Text="Windows Optimization Suite" FontSize="9.5" Foreground="{DynamicResource ThemeBrush_9298A1}" Margin="0,-1,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="24" Background="{DynamicResource ThemeBrush_4B2A12}" Margin="16,0"/>
                    <TextBlock Text="Seu Windows no seu melhor." FontSize="11" Foreground="{DynamicResource ThemeBrush_FF9A2E}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" Content="—"/>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Content="□"/>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Content="×"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource ThemeBrush_0A0A0A}" BorderBrush="{DynamicResource ThemeBrush_242424}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,10,0,0">
                            <Button x:Name="NavInicio" Style="{StaticResource NavButton}" Tag="Dashboard">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="22"/><TextBlock Text="Início"/></StackPanel>
                            </Button>
                            <Button x:Name="NavPresets" Style="{StaticResource NavButton}" Tag="Presets">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Width="22"/><TextBlock Text="Presets"/></StackPanel>
                            </Button>
                            <Button x:Name="NavPersonalizado" Style="{StaticResource NavButton}" Tag="Custom">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="22"/><TextBlock Text="Personalizado"/></StackPanel>
                            </Button>
                            <Button x:Name="NavBackup" Style="{StaticResource NavButton}" Tag="Backup">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Width="22"/><TextBlock x:Name="NavLabelBackup" Text="Backup / Restore"/></StackPanel>
                            </Button>
                            <Button x:Name="NavAnalise" Style="{StaticResource NavButton}" Tag="Analysis">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Width="22"/><TextBlock x:Name="NavLabelAnalysis" Text="Análise do Sistema"/></StackPanel>
                            </Button>
                            <Button x:Name="NavConfiguracoes" Style="{StaticResource NavButton}" Tag="Settings">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="22"/><TextBlock Text="Configurações"/></StackPanel>
                            </Button>
                            <Button x:Name="NavSobre" Style="{StaticResource NavButton}" Tag="About">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Width="22"/><TextBlock Text="Sobre"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="10,0,10,10" Padding="9" Background="{DynamicResource ThemeBrush_0E0E0E}" BorderBrush="{DynamicResource ThemeBrush_282828}" BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock Text="Win-Slim Suite" Foreground="{DynamicResource ThemeBrush_FF9A2E}" FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtBridgeState" Text="Conectando ao runtime..." Foreground="{DynamicResource ThemeBrush_8E949D}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content pages -->
                <Grid Grid.Column="1" x:Name="ContentHost" Background="{DynamicResource ThemeBrush_080808}" ClipToBounds="True">

                    <!-- Dashboard R3.2.60: reference composition, live read-only data -->
                    <Grid x:Name="PageDashboard" Visibility="Collapsed" Margin="20,18,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="102"/>
                            <RowDefinition Height="70"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Bem-vindo ao Win-Slim Suite" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Otimização e segurança do seu sistema em um só lugar." Foreground="{DynamicResource ThemeBrush_A9AFB8}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.03*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
