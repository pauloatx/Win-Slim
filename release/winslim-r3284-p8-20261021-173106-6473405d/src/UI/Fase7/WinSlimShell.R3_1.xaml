                    <!-- 3. PREVIEW: visual shell reserved for R5, now matching the reference layout -->
                    <Grid x:Name="PagePreview" Visibility="Collapsed" Margin="15,12,15,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,9"><TextBlock Text="Visualizar alterações" Style="{StaticResource PageTitle}"/><TextBlock Text="Confira o que será aplicado antes de continuar." Style="{StaticResource PageSubtitle}"/></StackPanel>
                        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="9"/><RowDefinition Height="*"/><RowDefinition Height="9"/><RowDefinition Height="88"/></Grid.RowDefinitions>
                            <UniformGrid Columns="3"><Border Style="{StaticResource CardCompact}" Margin="0,0,5,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="54" Foreground="{StaticResource AccentLight}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Tweaks selecionados" Foreground="{StaticResource Text2}" FontSize="8.5"/></StackPanel></Border><Border Style="{StaticResource CardCompact}" Margin="5,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="5" Foreground="{StaticResource AccentLight}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Reinícios necessários" Foreground="{StaticResource Text2}" FontSize="8.5"/></StackPanel></Border><Border Style="{StaticResource CardCompact}" Margin="5,0,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Baixo" Foreground="{StaticResource Green}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Risco geral" Foreground="{StaticResource Text2}" FontSize="8.5"/></StackPanel></Border></UniformGrid>
                            <Border Grid.Row="2" Style="{StaticResource CardCompact}"><StackPanel><TextBlock Text="Por categoria" Style="{StaticResource SectionTitle}"/><TextBlock Text="⚡ Performance                         18         Baixo        2" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,8,0,0"/><TextBlock Text="◉ Gaming                              14         Baixo        1" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,5,0,0"/><TextBlock Text="⌁ Network                              7         Médio        1" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,5,0,0"/><TextBlock Text="⚙ Services                             8         Médio        0" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,5,0,0"/><TextBlock Text="◇ Advanced                             7         Alto         5" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Grid.Row="4" Background="#08170E" BorderBrush="#17582F" BorderThickness="1" CornerRadius="5" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="✓ Backup completo será criado" Foreground="{StaticResource Green}" FontSize="9"/><TextBlock Text="✓ Nenhum conflito detectado" Foreground="{StaticResource Green}" FontSize="9" Margin="0,3,0,0"/><TextBlock Text="✓ Compatível com seu hardware" Foreground="{StaticResource Green}" FontSize="9" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Ver detalhes" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/></Grid></Border>
                        </Grid>
                        <Button Grid.Row="2" Content="◉  Criar Backup &amp; Aplicar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="205" Margin="0,9,0,0"/>
                    </Grid>

                    <!-- 4. APPLY -->
                    <Grid x:Name="PageApply" Visibility="Collapsed" Margin="15,12,15,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,9"><TextBlock Text="Aplicando otimizações" Style="{StaticResource PageTitle}"/><TextBlock Text="O processo será executado em etapas. Não feche o aplicativo." Style="{StaticResource PageSubtitle}"/></StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource CardCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Height="22"><Border Background="#242424" CornerRadius="4"/><Border Background="{StaticResource Accent}" CornerRadius="4" Width="420" HorizontalAlignment="Left"/><TextBlock Text="67%" Foreground="#090909" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/></Grid>
                            <StackPanel Grid.Row="1" Margin="0,11,0,8"><TextBlock Text="✓  Criando backup do sistema                                      concluído" Foreground="{StaticResource Green}" FontSize="9.5"/><TextBlock Text="✓  Aplicando tweaks de performance                                concluído" Foreground="{StaticResource Green}" FontSize="9.5" Margin="0,7,0,0"/><TextBlock Text="◉  Configurando rede e internet                                   em andamento" Foreground="{StaticResource Yellow}" FontSize="9.5" Margin="0,7,0,0"/><TextBlock Text="○  Ajustando serviços do Windows                                  pendente" Foreground="{StaticResource Text2}" FontSize="9.5" Margin="0,7,0,0"/><TextBlock Text="○  Otimizações avançadas                                          pendente" Foreground="{StaticResource Text2}" FontSize="9.5" Margin="0,7,0,0"/></StackPanel>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#0B0B0B" BorderBrush="#262626" BorderThickness="1" CornerRadius="4" Padding="8"><StackPanel><TextBlock Text="Em andamento:" Foreground="{StaticResource Text2}" FontSize="8"/><TextBlock Text="PERF-016 — MSI Mode GPU" Foreground="{StaticResource Text}" FontSize="9"/></StackPanel></Border><Button Grid.Column="2" Content="Cancelar" Style="{StaticResource SecondaryButton}" VerticalAlignment="Stretch"/></Grid>
                        </Grid></Border>
                        <TextBlock Grid.Row="2" Text="Operação atual: Aplicando alteração no dispositivo GPU..." Foreground="{StaticResource Muted}" FontSize="8.5" Margin="0,7,0,0"/>
                    </Grid>

                    <!-- 5. RESULT -->
                    <Grid x:Name="PageResult" Visibility="Collapsed" Margin="15,12,15,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,12"><Border Width="48" Height="48" CornerRadius="24" Background="#21B85B"><TextBlock Text="✓" Foreground="#06130A" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Otimização concluída!" Foreground="{StaticResource Text}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Todas as alterações foram aplicadas com sucesso." Foreground="{StaticResource Text2}" FontSize="9.5"/></StackPanel>
                        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="10"/><RowDefinition Height="78"/></Grid.RowDefinitions><UniformGrid Columns="4"><Border Style="{StaticResource CardCompact}" Margin="0,0,4,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="51" Foreground="{StaticResource AccentLight}" FontSize="17"/><TextBlock Text="Aplicadas" Foreground="{StaticResource Text2}" FontSize="8.5"/></StackPanel></Border><Border Style="{StaticResource CardCompact}" Margin="4,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="3" Foreground="{StaticResource Yellow}" FontSize="17"/><TextBlock Text="Aguardando reinício" Foreground="{StaticResource Text2}" FontSize="8.5"/></StackPanel></Border><Border Style="{StaticResource CardCompact}" Margin="4,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="0" Foreground="{StaticResource Green}" FontSize="17"/><TextBlock Text="Falhas" Foreground="{StaticResource Text2}" FontSize="8.5"/></StackPanel></Border><Border Style="{StaticResource CardCompact}" Margin="4,0,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="0" Foreground="{StaticResource Green}" FontSize="17"/><TextBlock Text="Conflitos" Foreground="{StaticResource Text2}" FontSize="8.5"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Background="#08170E" BorderBrush="#1A6E38" BorderThickness="1" CornerRadius="5" Padding="10"><StackPanel><TextBlock Text="ⓘ  Reinicialização necessária" Foreground="{StaticResource Green}" FontSize="10.5" FontWeight="SemiBold"/><TextBlock Text="Para que todas as alterações tenham efeito, reinicie o sistema." Foreground="{StaticResource Text2}" FontSize="8.5" Margin="0,3,0,0"/></StackPanel></Border></Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="↻ Reiniciar agora" Style="{StaticResource PrimaryButton}"/><Button Grid.Column="2" Content="Reiniciar mais tarde" Style="{StaticResource SecondaryButton}"/></Grid>
                    </Grid>

                    <!-- 8. TWEAK DETAIL -->
                    <Grid x:Name="PageTweakDetail" Visibility="Collapsed" Margin="15,12,15,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,9"><TextBlock Text="WinSlim CPU Idle States" Style="{StaticResource PageTitle}"/><TextBlock Text="Informações completas e ações específicas." Style="{StaticResource PageSubtitle}"/></StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource CardCompact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#34220A" CornerRadius="8" Padding="7,3" HorizontalAlignment="Left"><TextBlock Text="Experimental" Foreground="{StaticResource Yellow}" FontSize="8.5"/></Border><TextBlock Grid.Column="1" Text="● Ativo" Foreground="{StaticResource Green}" FontSize="9"/></Grid><TextBlock Grid.Row="1" Text="Desativa os estados de economia de energia da CPU, mantendo o processador em estados de maior atividade." Foreground="{StaticResource Text2}" FontSize="9.5" TextWrapping="Wrap" Margin="0,9,0,9"/><StackPanel Grid.Row="2"><TextBlock Text="Risco:          Médio" Foreground="{StaticResource Text2}" FontSize="9.5"/><TextBlock Text="Reinício:       Sim" Foreground="{StaticResource Text2}" FontSize="9.5" Margin="0,4,0,0"/><TextBlock Text="Rollback:       Disponível" Foreground="{StaticResource Text2}" FontSize="9.5" Margin="0,4,0,0"/><TextBlock Text="Hardware:       CPU compatível" Foreground="{StaticResource Text2}" FontSize="9.5" Margin="0,4,0,0"/><TextBlock Text="Dependências:   Nenhuma" Foreground="{StaticResource Text2}" FontSize="9.5" Margin="0,4,0,0"/><TextBlock Text="Conflitos:      CPU Power Saving" Foreground="{StaticResource Text2}" FontSize="9.5" Margin="0,4,0,0"/></StackPanel><Border Grid.Row="3" Background="#39270D" BorderBrush="#9A6300" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,10,0,0"><TextBlock Text="⚠ Pode aumentar o consumo de energia e temperatura. Use apenas se souber o efeito desta alteração." Foreground="{StaticResource Yellow}" FontSize="8.5" TextWrapping="Wrap"/></Border></Grid></Border>
                        <Grid Grid.Row="2" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Desfazer" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Content="Aplicar" Style="{StaticResource PrimaryButton}"/></Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#090909" BorderBrush="#262626" BorderThickness="0,1,0,0">
                <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TxtStatus" Text="Pronto — Início" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="UI → RuntimePromotion → PlannerOptimized → TransactionOptimized" Foreground="#626262" FontSize="7.8" VerticalAlignment="Center"/></Grid>
            </Border>
        </Grid>
    </Border>
</Window>
