<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Win-Slim Suite — FASE 7 R3.1"
        Width="1080" Height="700" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#080808" FontFamily="Segoe UI"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#080808"/>
        <SolidColorBrush x:Key="Panel" Color="#111111"/>
        <SolidColorBrush x:Key="Panel2" Color="#151515"/>
        <SolidColorBrush x:Key="Panel3" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="Stroke" Color="#292929"/>
        <SolidColorBrush x:Key="StrokeSoft" Color="#202020"/>
        <SolidColorBrush x:Key="Accent" Color="#FF7A00"/>
        <SolidColorBrush x:Key="AccentLight" Color="#FF9A2E"/>
        <SolidColorBrush x:Key="AccentDark" Color="#C85A00"/>
        <SolidColorBrush x:Key="Text" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="Text2" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="Muted" Color="#777777"/>
        <SolidColorBrush x:Key="Green" Color="#23D66F"/>
        <SolidColorBrush x:Key="Yellow" Color="#FFBC35"/>
        <SolidColorBrush x:Key="Red" Color="#FF4D4D"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="CardCompact" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="5,1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#201208"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#140A02"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#343434"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#222222"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B0B0B"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#7B3508" BorderThickness="1" Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- Compact application title bar. The large marketing strip from the concept board is intentionally not part of the app window. -->
            <Border Grid.Row="0" Background="#0B0B0B" BorderBrush="#6C2D05" BorderThickness="0,0,0,1">
                <Grid x:Name="TopDragArea" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="108"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Viewbox Width="17" Height="24" Margin="0,0,7,0">
                            <Canvas Width="32" Height="46"><Path Fill="{StaticResource Accent}" Data="M18,1 L5,24 L15,24 L9,45 L28,18 L18,18 L26,1 Z"/></Canvas>
                        </Viewbox>
                        <TextBlock Text="Win-Slim Suite" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  Windows Optimization Suite" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Button x:Name="BtnMinimize" Content="─" Width="36" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" FontSize="12"/>
                        <Button x:Name="BtnMaximize" Content="□" Width="36" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" FontSize="10"/>
                        <Button x:Name="BtnClose" Content="×" Width="36" Background="Transparent" Foreground="#D0D0D0" BorderThickness="0" FontSize="15"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Compact sidebar matching the embedded screens in the supplied reference. -->
                <Border Grid.Column="0" Background="#0B0B0B" BorderBrush="#242424" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,7,0,0">
                            <Button x:Name="NavInicio" Content="⌂   Início" Style="{StaticResource NavButton}"/>
                            <Button x:Name="NavPresets" Content="✂   Presets" Style="{StaticResource NavButton}"/>
                            <Button x:Name="NavPersonalizado" Content="☷   Personalizado" Style="{StaticResource NavButton}"/>
                            <Button x:Name="NavBackup" Content="↶   Backup / Restore" Style="{StaticResource NavButton}"/>
                            <Button x:Name="NavAnalise" Content="◉   Análise do Sistema" Style="{StaticResource NavButton}"/>
                            <Button x:Name="NavConfiguracoes" Content="⚙   Configurações" Style="{StaticResource NavButton}"/>
                            <Button x:Name="NavSobre" Content="ⓘ   Sobre" Style="{StaticResource NavButton}"/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="8,0,8,8" Background="#0E0E0E" BorderBrush="#292929" BorderThickness="1" CornerRadius="5" Padding="8">
                            <StackPanel>
                                <TextBlock Text="◉ Em modo" Foreground="{StaticResource Text2}" FontSize="8.5"/>
                                <TextBlock Text="FASE 7 R3.1" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtRuntimeState" Text="Runtime: carregando..." Foreground="{StaticResource Muted}" FontSize="8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtBackendState" Text="Backend: carregando..." Foreground="{StaticResource Muted}" FontSize="8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- CONTENT -->
                <Grid Grid.Column="1" Background="{StaticResource Bg}">

                    <!-- 1. DASHBOARD -->
                    <Grid x:Name="PageInicio" Margin="15,12,15,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Início — Dashboard" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Visão geral do sistema e drive de ação principal." Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Bem-vindo ao Win-Slim Suite" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Otimização segura do seu sistema em um só lugar." Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="0,10,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#0B0B0B" BorderBrush="#262626" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,5,0">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="4" Background="#241206" VerticalAlignment="Center"><TextBlock Text="⊞" Foreground="{StaticResource Accent}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtSystemPrimary" Text="Windows 10/11" Foreground="{StaticResource Text}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="TxtSystemSecondary" Text="Build · arquitetura · dispositivo" Foreground="{StaticResource Text2}" FontSize="8.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="TxtSystemHardware" Text="CPU · GPU · RAM" Foreground="{StaticResource Muted}" FontSize="8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="1" Background="#0B0B0B" BorderBrush="#262626" BorderThickness="1" CornerRadius="5" Padding="9" Margin="5,0,0,0">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Backend aprovado" Foreground="{StaticResource Text}" FontSize="10" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtRuntimeDetail" Text="Planner / Transaction" Foreground="{StaticResource AccentLight}" FontSize="8.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="TxtDeviceType" Text="Dispositivo: detectando..." Foreground="{StaticResource Text2}" FontSize="8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <UniformGrid Grid.Row="2" Columns="3">
                                            <Border Background="#09180F" BorderBrush="#15552D" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,5,0"><TextBlock x:Name="TxtCompatibilityBadge" Text="✓ Sistema compatível" Foreground="{StaticResource Green}" FontSize="8.2" HorizontalAlignment="Center"/></Border>
                                            <Border Background="#09180F" BorderBrush="#15552D" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0"><TextBlock x:Name="TxtAdminBadge" Text="✓ Administrador" Foreground="{StaticResource Green}" FontSize="8.2" HorizontalAlignment="Center"/></Border>
                                            <Border Background="#09180F" BorderBrush="#15552D" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="5,0,0,0"><TextBlock Text="✓ Backup disponível" Foreground="{StaticResource Green}" FontSize="8.2" HorizontalAlignment="Center"/></Border>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Desempenho atual" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="TxtMetricTimestamp" Grid.Column="1" Text="--:--:--" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center"/>
                                        </Grid>
                                        <UniformGrid Grid.Row="1" Columns="4" Margin="4,9,4,8">
                                            <StackPanel HorizontalAlignment="Center"><Border Width="48" Height="48" CornerRadius="24" BorderBrush="{StaticResource Accent}" BorderThickness="2"><TextBlock x:Name="TxtMetricCpu" Text="--" Style="{StaticResource MetricText}"/></Border><TextBlock Text="CPU" Foreground="{StaticResource Text2}" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                                            <StackPanel HorizontalAlignment="Center"><Border Width="48" Height="48" CornerRadius="24" BorderBrush="{StaticResource Accent}" BorderThickness="2"><TextBlock x:Name="TxtMetricGpu" Text="--" Style="{StaticResource MetricText}"/></Border><TextBlock Text="GPU" Foreground="{StaticResource Text2}" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                                            <StackPanel HorizontalAlignment="Center"><Border Width="48" Height="48" CornerRadius="24" BorderBrush="{StaticResource Accent}" BorderThickness="2"><TextBlock x:Name="TxtMetricRam" Text="--" Style="{StaticResource MetricText}"/></Border><TextBlock Text="RAM" Foreground="{StaticResource Text2}" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                                            <StackPanel HorizontalAlignment="Center"><Border Width="48" Height="48" CornerRadius="24" BorderBrush="{StaticResource Accent}" BorderThickness="2"><TextBlock x:Name="TxtMetricDisk" Text="--" Style="{StaticResource MetricText}"/></Border><TextBlock Text="Disco" Foreground="{StaticResource Text2}" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                                        </UniformGrid>
                                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Button x:Name="BtnAnalyzeSystem" Content="⌕  ANALISAR SISTEMA" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                                            <Button x:Name="BtnRefreshDashboard" Grid.Column="2" Content="↻" Width="34" Style="{StaticResource SecondaryButton}" ToolTip="Atualizar leitura"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Status do Win-Slim" Style="{StaticResource SectionTitle}"/>
                                    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tweaks aplicados" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock Grid.Column="1" Text="0 / 230" Foreground="{StaticResource Text}" FontSize="9" FontWeight="SemiBold"/></Grid>
                                    <Separator Grid.Row="2" Background="#272727" Margin="0,7"/>
                                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tweaks disponíveis" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock x:Name="TxtTweakCount" Grid.Column="1" Text="230 / 230" Foreground="{StaticResource Text}" FontSize="9" FontWeight="SemiBold"/></Grid>
                                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Presets" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock Grid.Column="1" Text="3" Foreground="{StaticResource AccentLight}" FontSize="9"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Reinício pendente" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock x:Name="TxtPendingReboot" Grid.Column="1" Text="Detectando..." Foreground="{StaticResource Text}" FontSize="9"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Último backup" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource Muted}" FontSize="9"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Última otimização" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource Muted}" FontSize="9"/></Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="0,14,0,0">
                                        <Border Background="#09180F" BorderBrush="#15552D" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,0,6"><TextBlock Text="✓ Sistema compatível" Foreground="{StaticResource Green}" FontSize="8.5"/></Border>
                                        <Border Background="#09180F" BorderBrush="#15552D" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,0,6"><TextBlock Text="✓ Runtime promovido" Foreground="{StaticResource Green}" FontSize="8.5"/></Border>
                                        <Border Background="#09180F" BorderBrush="#15552D" BorderThickness="1" CornerRadius="4" Padding="7,5"><TextBlock Text="✓ Rollback preservado" Foreground="{StaticResource Green}" FontSize="8.5"/></Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="6" Text="FASE 7 R3.1 · layout fiel ao conceito" Foreground="{StaticResource Muted}" FontSize="8" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 2. PRESETS -->
                    <ScrollViewer x:Name="PagePresets" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="15,12,15,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="Presets" Style="{StaticResource PageTitle}"/><TextBlock Text="Escolha um perfil de otimização." Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"/></StackPanel>
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,9">
                                <Border x:Name="CardPresetBalanced" Background="#0E1711" BorderBrush="#16894A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="◒" Foreground="{StaticResource Green}" FontSize="29" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Margin="0,4,0,0"><TextBlock Text="Equilibrado" Foreground="{StaticResource Green}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Estabilidade e responsividade" Foreground="{StaticResource Text2}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Row="2" Margin="8,10,0,10"><TextBlock Text="✓ Performance" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock Text="✓ Privacidade moderada" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="✓ Limpeza do sistema" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="✓ Baixo risco" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/></StackPanel>
                                        <Button x:Name="BtnPresetBalanced" Grid.Row="3" Content="Aplicar Equilibrado" Style="{StaticResource PrimaryButton}" Background="#19B75D"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="CardPresetGamer" Background="#171109" BorderBrush="#C85A00" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="🎮" FontSize="25" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Margin="0,4,0,0"><TextBlock Text="Gamer" Foreground="{StaticResource AccentLight}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Otimizações para jogos e latência" Foreground="{StaticResource Text2}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Row="2" Margin="8,10,0,10"><TextBlock Text="✓ FPS / Latência" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock Text="✓ GPU e CPU" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="✓ Rede e energia" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="✓ Game Mode" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/></StackPanel>
                                        <Button x:Name="BtnPresetGamer" Grid.Row="3" Content="Aplicar Gamer" Style="{StaticResource PrimaryButton}"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="CardPresetExtreme" Background="#180D0D" BorderBrush="#8A2929" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="🚀" FontSize="25" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Margin="0,4,0,0"><TextBlock Text="Extremo" Foreground="{StaticResource Red}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Máximo desempenho" Foreground="{StaticResource Text2}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Row="2" Margin="8,10,0,10"><TextBlock Text="✓ Menos recursos" Foreground="{StaticResource Text2}" FontSize="9"/><TextBlock Text="✓ Mais desempenho" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="✓ Maior risco" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="✓ Ajustes avançados" Foreground="{StaticResource Text2}" FontSize="9" Margin="0,4,0,0"/></StackPanel>
                                        <Button x:Name="BtnPresetExtreme" Grid.Row="3" Content="Aplicar Extremo" Style="{StaticResource PrimaryButton}" Background="#E04545"/>
                                    </Grid>
                                </Border>
                            </UniformGrid>
