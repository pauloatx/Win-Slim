                        <Border Grid.Row="1" Style="{StaticResource CardCompact}" MaxWidth="600" HorizontalAlignment="Left"><StackPanel><TextBlock Text="Win-Slim Suite" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="FASE 7 R3.1 — correção visual de layout" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,3,0,9"/><TextBlock Text="A interface foi reorganizada para reproduzir o layout compacto das telas internas da referência fornecida: title bar fina, sidebar estreita, cards densos e fluxo visual sem o banner externo da prancha." Foreground="{StaticResource Text2}" FontSize="10" TextWrapping="Wrap" LineHeight="16"/><TextBlock Text="Backend: 230 tweaks · Presets: 105 / 129 / 168" Foreground="{StaticResource Text}" FontSize="9.5" Margin="0,10,0,0"/></StackPanel></Border>
