<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource ThemeBrush_080808}" Foreground="{DynamicResource ThemeBrush_E5E7EB}" FontFamily="Segoe UI" FontSize="14">
<UserControl.Resources>
        <SolidColorBrush x:Key="Bg" Color="{DynamicResource ThemeColor_080808}"/>
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource ThemeColor_111111}"/>
        <SolidColorBrush x:Key="Panel2" Color="{DynamicResource ThemeColor_151515}"/>
        <SolidColorBrush x:Key="Panel3" Color="{DynamicResource ThemeColor_0D0D0D}"/>
        <SolidColorBrush x:Key="Border" Color="{DynamicResource ThemeColor_2A2A2A}"/>
        <SolidColorBrush x:Key="Orange" Color="{DynamicResource ThemeColor_FF7A00}"/>
        <SolidColorBrush x:Key="OrangeLight" Color="{DynamicResource ThemeColor_FF9A2E}"/>
        <SolidColorBrush x:Key="OrangeDark" Color="{DynamicResource ThemeColor_C85A00}"/>
        <SolidColorBrush x:Key="Muted" Color="{DynamicResource ThemeColor_A9AFB8}"/>
        <SolidColorBrush x:Key="Green" Color="{DynamicResource ThemeColor_14C767}"/>
        <SolidColorBrush x:Key="Red" Color="{DynamicResource ThemeColor_FF3152}"/>
        <SolidColorBrush x:Key="Amber" Color="{DynamicResource ThemeColor_FFC107}"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C8CDD5}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_202020}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_2A2A2A}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_C42B1C}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C7CCD4}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1"><Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_171717}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_23170D}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_FF7A00}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_FF8A18}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_C85A00}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_39BFC3}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="LinkBorder" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,2"><Grid>
                    <ContentPresenter/>
                <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeBrush_7CDADD}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_39BFC3}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_111111}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E7E9ED}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_3A3A3A}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_171717}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_21170E}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayChip" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_101215}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C8CDD5}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_343A42}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><Grid>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="15" Height="15" CornerRadius="8" BorderBrush="{DynamicResource ThemeBrush_737A84}" BorderThickness="2" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                            </Grid>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ThemeBrush_18130F}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ThemeBrush_4A2407}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighRiskChip" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_78591A}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_422B08}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_FFC107}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FFE08A}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="SmallCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E5E7EB}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FF7A00}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_202020}"/>
        </Style>

        <Style x:Key="BackupRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_0C0F10}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_F5F5F5}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="BackupRowBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ThemeBrush_242B30}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="{DynamicResource ThemeBrush_21170E}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="{DynamicResource ThemeBrush_3A1E0B}"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BackupRowBorder" Property="BorderThickness" Value="1"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    
        <Style x:Key="CustomCategory" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="8,1"/><Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="CustomTweakSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="126"/><Setter Property="Height" Value="30"/><Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E5E7EB}"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="CustomSwitchFocus" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="2"><Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <ContentPresenter Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border x:Name="CustomSwitchTrack" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="{DynamicResource ThemeBrush_42474D}" BorderBrush="{DynamicResource ThemeBrush_747B84}" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="CustomSwitchThumb" Width="14" Height="14" Fill="{DynamicResource ThemeBrush_FFFFFF}" HorizontalAlignment="Left" Margin="2,0"/></Border>
                </Grid><Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CustomSwitchTrack" Property="Background" Value="{DynamicResource ThemeBrush_00C853}"/><Setter TargetName="CustomSwitchTrack" Property="BorderBrush" Value="{DynamicResource ThemeBrush_55DD91}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CustomSwitchTrack" Property="BorderBrush" Value="{DynamicResource ThemeBrush_55DD91}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CustomSwitchFocus" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
</UserControl.Resources>
<Border BorderThickness="0" Background="{DynamicResource ThemeBrush_080808}"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition/></Grid.RowDefinitions>
<Grid x:Name="TweakTitleBar" Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="DetailBrandMark" Data="F0 M34 2 C22 2 11 10 7 21 C9 21 12 20 15 18 C13 21 10 23 7 24 C7 28 8 31 11 33 C9 36 6 39 4 41 C3 42 5 44 6 43 C9 40 12 37 14 34 C20 33 25 29 29 23 C26 24 23 25 20 25 C24 23 28 21 31 18 C33 13 34 7 34 2 Z M11 33 C15 23 23 13 30 7 C24 15 18 25 13 34 Z" Fill="{DynamicResource ThemeAccent}" Width="22" Height="28" Stretch="Uniform"/><TextBlock Text="Win-Slim Suite" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnTweakMinimize" Style="{StaticResource TitleBarButton}" Content="—"/><Button x:Name="BtnTweakMaximize" Style="{StaticResource TitleBarButton}" Content="□"/><Button x:Name="BtnTweakClose" Style="{StaticResource CloseButton}" Content="×"/></StackPanel></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,10,24,20"><StackPanel MaxWidth="940" HorizontalAlignment="Stretch">
<Button x:Name="BtnTweakBack" Style="{StaticResource SecondaryButton}" Content="← Voltar" HorizontalAlignment="Left" Height="30" Padding="16,0" Background="{DynamicResource ThemeBrush_241A10}" BorderBrush="{DynamicResource ThemeBrush_8A5525}" Foreground="{DynamicResource ThemeBrush_FFC078}" Margin="0,0,0,12" ToolTip="Voltar à tela anterior preservando sua seleção e posição."/>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="{DynamicResource ThemeBrush_FF7A00}" FontSize="28" Margin="0,0,10,0"/><TextBlock x:Name="TxtTweakName" Text="Detalhe do tweak" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="740"/></StackPanel><Border Background="{DynamicResource ThemeBrush_302200}" BorderBrush="{DynamicResource ThemeBrush_9C6500}" BorderThickness="1" CornerRadius="16" Padding="12,5" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock x:Name="TxtTweakBadge" Text="Ajuste do catálogo" Foreground="{DynamicResource ThemeBrush_FFC107}" FontWeight="SemiBold" FontSize="12"/></Border></StackPanel><Border x:Name="TweakStateBadge" Grid.Column="1" Background="{DynamicResource ThemeBrush_052415}" BorderBrush="{DynamicResource ThemeBrush_095D32}" BorderThickness="1" CornerRadius="18" Padding="12,6" VerticalAlignment="Top" Margin="14,5,0,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="TweakStateDot" Fill="{DynamicResource ThemeBrush_00C853}" Width="12" Height="12" VerticalAlignment="Center"/><TextBlock x:Name="TxtTweakState" Text="Ativo" Foreground="{DynamicResource ThemeBrush_36E493}" Margin="8,0,0,0" FontWeight="SemiBold"/></StackPanel></Border></Grid>
<TextBlock x:Name="TxtTweakDescription" Text="Carregando informações do catálogo..." FontSize="16" Foreground="{DynamicResource ThemeBrush_C7CCD4}" TextWrapping="Wrap" Margin="0,0,0,18"/>
<StackPanel x:Name="TweakMetadataRows"><Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="◐" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Risco:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_C7CCD4}"/><TextBlock x:Name="TxtTweakRisk" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="{DynamicResource ThemeBrush_FFC107}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="♟" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Reinício:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_C7CCD4}"/><TextBlock x:Name="TxtTweakRestart" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="{DynamicResource ThemeBrush_FFC107}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="↶" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Rollback:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_C7CCD4}"/><TextBlock x:Name="TxtTweakRollback" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="{DynamicResource ThemeBrush_78BDCF}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="◎" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Compatibilidade:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_C7CCD4}"/><TextBlock x:Name="TxtTweakCompatibility" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="{DynamicResource ThemeBrush_00C853}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="◇" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Hardware:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_C7CCD4}"/><TextBlock x:Name="TxtTweakHardware" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="{DynamicResource ThemeBrush_BCC8D2}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⊙" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Dependências:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_C7CCD4}"/><TextBlock x:Name="TxtTweakDependencies" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="{DynamicResource ThemeBrush_BCC8D2}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⊗" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Conflitos:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource ThemeBrush_C7CCD4}"/><TextBlock x:Name="TxtTweakConflicts" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="{DynamicResource ThemeBrush_BCC8D2}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
</StackPanel>
<Border Background="{DynamicResource ThemeBrush_4B3105}" BorderBrush="{DynamicResource ThemeBrush_B87900}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,16,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⚠" Foreground="{DynamicResource ThemeBrush_FFD54F}" FontSize="27" VerticalAlignment="Center"/><TextBlock x:Name="TxtTweakWarning" Grid.Column="1" Text="Confira o risco e a compatibilidade antes de continuar." Foreground="{DynamicResource ThemeBrush_FFE6AC}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"/></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="BtnTweakUndo" Style="{StaticResource SecondaryButton}" Content="↶  Desfazer" Height="46" FontSize="16" BorderBrush="{DynamicResource ThemeBrush_826447}" ToolTip="Retira este ajuste da seleção. Não restaura configurações do Windows nesta demonstração."/><Button x:Name="BtnTweakApply" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Aplicar" Height="46" FontSize="16" ToolTip="Seleciona o ajuste e abre sua pré-visualização. A execução permanece em demonstração."/></Grid>
<TextBlock x:Name="TxtTweakDetailStatus" Text="Ativo significa selecionado · ações em modo de demonstração · nenhuma alteração no Windows." Foreground="{DynamicResource ThemeBrush_FF9A2E}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></Grid></Border></UserControl>