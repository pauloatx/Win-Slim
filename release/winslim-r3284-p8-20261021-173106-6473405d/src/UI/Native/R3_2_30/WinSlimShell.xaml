<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Win-Slim Suite"
        Width="1180" Height="760" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#080808" AllowsTransparency="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#080808"/>
        <SolidColorBrush x:Key="Panel" Color="#111111"/>
        <SolidColorBrush x:Key="Panel2" Color="#151515"/>
        <SolidColorBrush x:Key="Panel3" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="Border" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Orange" Color="#FF7A00"/>
        <SolidColorBrush x:Key="OrangeLight" Color="#FF9A2E"/>
        <SolidColorBrush x:Key="OrangeDark" Color="#C85A00"/>
        <SolidColorBrush x:Key="Muted" Color="#A9AFB8"/>
        <SolidColorBrush x:Key="Green" Color="#14C767"/>
        <SolidColorBrush x:Key="Red" Color="#FF3152"/>
        <SolidColorBrush x:Key="Amber" Color="#FFC107"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8CDD5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202020"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7CCD4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9A2E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#171717"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23170D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF9A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF8A18"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C85A00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#39BFC3"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="LinkBorder" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,2">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#7CDADD"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkBorder" Property="BorderBrush" Value="#39BFC3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#E7E9ED"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Bd" Property="Background" Value="#171717"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21170E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayChip" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#101215"/>
            <Setter Property="Foreground" Value="#C8CDD5"/>
            <Setter Property="BorderBrush" Value="#343A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="15" Height="15" CornerRadius="8" BorderBrush="#737A84" BorderThickness="2" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Chip" Property="Background" Value="#18130F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#4A2407"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Dot" Property="Background" Value="#FF7A00"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="#FF9A2E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighRiskChip" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="BorderBrush" Value="#78591A"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#422B08"/>
                    <Setter Property="BorderBrush" Value="#FFC107"/>
                    <Setter Property="Foreground" Value="#FFE08A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="SmallCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="#FF7A00"/>
            <Setter Property="Background" Value="#202020"/>
        </Style>

        <Style x:Key="BackupRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#0C0F10"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="BackupRowBorder" Background="{TemplateBinding Background}" BorderBrush="#242B30" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="#21170E"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="#3A1E0B"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="#FF7A00"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BackupRowBorder" Property="BorderThickness" Value="1"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="#FF9A2E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C85A00" BorderThickness="1" Background="#080808">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Compact native title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="#090909">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="M15,0 L6,14 L13,14 L8,28 L24,10 L16,10 Z" Fill="#FF7A00" Width="22" Height="28" Stretch="Fill" Margin="0,0,9,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Win-Slim Suite" FontWeight="Bold" FontSize="15" Foreground="White"/>
                        <TextBlock Text="Windows Optimization Suite" FontSize="9.5" Foreground="#9298A1" Margin="0,-1,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="24" Background="#4B2A12" Margin="16,0"/>
                    <TextBlock Text="Seu Windows no seu melhor." FontSize="11" Foreground="#FF9A2E" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" Content="—"/>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Content="□"/>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Content="×"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#0A0A0A" BorderBrush="#242424" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,10,0,0">
                            <Button x:Name="NavInicio" Style="{StaticResource NavButton}" Tag="Dashboard">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="22"/><TextBlock Text="Início"/></StackPanel>
                            </Button>
                            <Button x:Name="NavPresets" Style="{StaticResource NavButton}" Tag="Presets">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Width="22"/><TextBlock Text="Presets"/></StackPanel>
                            </Button>
                            <Button x:Name="NavPersonalizado" Style="{StaticResource NavButton}" Tag="Custom">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="22"/><TextBlock Text="Personalizado"/></StackPanel>
                            </Button>
                            <Button x:Name="NavBackup" Style="{StaticResource NavButton}" Tag="Backup">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Width="22"/><TextBlock x:Name="NavLabelBackup" Text="Backup / Restore"/></StackPanel>
                            </Button>
                            <Button x:Name="NavAnalise" Style="{StaticResource NavButton}" Tag="Analysis">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Width="22"/><TextBlock x:Name="NavLabelAnalysis" Text="Análise do Sistema"/></StackPanel>
                            </Button>
                            <Button x:Name="NavConfiguracoes" Style="{StaticResource NavButton}" Tag="Settings">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="22"/><TextBlock Text="Configurações"/></StackPanel>
                            </Button>
                            <Button x:Name="NavSobre" Style="{StaticResource NavButton}" Tag="About">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Width="22"/><TextBlock Text="Sobre"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="10,0,10,10" Padding="9" Background="#0E0E0E" BorderBrush="#282828" BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock Text="Win-Slim Suite" Foreground="#FF9A2E" FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtBridgeState" Text="Conectando ao runtime..." Foreground="#8E949D" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content pages -->
                <Grid Grid.Column="1" x:Name="ContentHost" Background="#080808" ClipToBounds="True">

                    <!-- Dashboard R3.2.30: reference composition, live read-only data -->
                    <Grid x:Name="PageDashboard" Visibility="Collapsed" Margin="20,18,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="102"/>
                            <RowDefinition Height="70"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Bem-vindo ao Win-Slim Suite" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Otimização e segurança do seu sistema em um só lugar." Foreground="#A9AFB8" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.03*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                            <Border Background="#0B1011" BorderBrush="#17302B" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,10,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Data="M0,3 L14,1 L14,15 L0,15 Z M17,1 L34,0 L34,15 L17,15 Z M0,18 L14,18 L14,31 L0,29 Z M17,18 L34,18 L34,33 L17,31 Z" Fill="#FF9A2E" Width="34" Height="33" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDashWindows" Text="Windows · aguardando leitura" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtDashBuild" Text="Build —" Foreground="#A9AFB8" FontSize="11" Margin="0,3,0,0"/>
                                        <Button x:Name="BtnDashDetails" Style="{StaticResource DashboardLink}" HorizontalAlignment="Left" Padding="0" Margin="0,7,0,0" Content="Ver detalhes" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="#0B1011" BorderBrush="#17302B" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,10,0">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE950;" Foreground="#39BFC3" FontSize="15" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="TxtDashCpu" Text="CPU · aguardando leitura" FontSize="11.5" TextTrimming="CharacterEllipsis"/></Grid>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Foreground="#A9AFB8"/><TextBlock Grid.Column="1" x:Name="TxtDashCores" Text="Núcleos / threads · —" FontSize="10.5" Foreground="#A9AFB8"/></Grid>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Foreground="#A9AFB8"/><TextBlock Grid.Column="1" x:Name="TxtDashRam" Text="RAM · —" FontSize="10.5" Foreground="#A9AFB8"/></Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0B1011" BorderBrush="#17302B" BorderThickness="1" CornerRadius="7" Padding="15">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Foreground="#A9AFB8" FontSize="14"/><TextBlock Grid.Column="1" x:Name="TxtDashGpu" Text="GPU · aguardando leitura" FontSize="11.5" TextTrimming="CharacterEllipsis"/></Grid>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDA2;" Foreground="#A9AFB8"/><TextBlock Grid.Column="1" x:Name="TxtDashDriver" Text="Driver · —" FontSize="10.5" Foreground="#A9AFB8" TextTrimming="CharacterEllipsis"/></Grid>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE958;" Foreground="#A9AFB8"/><TextBlock Grid.Column="1" x:Name="TxtDashStorage" Text="Armazenamento · —" FontSize="10.5" Foreground="#A9AFB8" TextTrimming="CharacterEllipsis"/></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,12,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="#0B1011" BorderBrush="#17302B" BorderThickness="1" CornerRadius="7" Padding="14,8" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="IconDashCompatible" FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="#A9AFB8" FontSize="22" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="TxtDashCompatible" Text="Compatibilidade&#x0A;a verificar" FontSize="12" VerticalAlignment="Center"/></Grid></Border>
                            <Border Grid.Column="1" Background="#0B1011" BorderBrush="#17302B" BorderThickness="1" CornerRadius="7" Padding="14,8" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="IconDashAdmin" FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Foreground="#A9AFB8" FontSize="22" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="TxtDashAdmin" Text="Administrador&#x0A;a verificar" FontSize="12" VerticalAlignment="Center"/></Grid></Border>
                            <Border Grid.Column="2" Background="#0B1011" BorderBrush="#17302B" BorderThickness="1" CornerRadius="7" Padding="14,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Foreground="#A9AFB8" FontSize="22" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="TxtDashBackup" Text="Backup&#x0A;não informado" FontSize="12" VerticalAlignment="Center" ToolTip="O bridge desta etapa não consulta o histórico de backups."/></Grid></Border>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,12,0,0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,0,18,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="142"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Desempenho atual" FontWeight="SemiBold" FontSize="15"/>
                                <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,0">
                                    <StackPanel HorizontalAlignment="Center"><Grid Width="88" Height="88"><Ellipse Stroke="#28302F" StrokeThickness="4" Margin="4"/><Path x:Name="ArcMetricCpu" Stroke="#FF7A00" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="TxtMetricCpu" Text="—" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="CPU" Foreground="#A9AFB8" HorizontalAlignment="Center" FontSize="12" Margin="0,9,0,0"/></StackPanel>
<StackPanel HorizontalAlignment="Center"><Grid Width="88" Height="88"><Ellipse Stroke="#28302F" StrokeThickness="4" Margin="4"/><Path x:Name="ArcMetricGpu" Stroke="#FF7A00" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="TxtMetricGpu" Text="—" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="GPU" Foreground="#A9AFB8" HorizontalAlignment="Center" FontSize="12" Margin="0,9,0,0"/></StackPanel>
<StackPanel HorizontalAlignment="Center"><Grid Width="88" Height="88"><Ellipse Stroke="#28302F" StrokeThickness="4" Margin="4"/><Path x:Name="ArcMetricRam" Stroke="#FF7A00" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="TxtMetricRam" Text="—" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="RAM" Foreground="#A9AFB8" HorizontalAlignment="Center" FontSize="12" Margin="0,9,0,0"/></StackPanel>
