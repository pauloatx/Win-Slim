<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Win-Slim Suite"
        Width="1180" Height="760" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#080808" AllowsTransparency="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#080808"/>
        <SolidColorBrush x:Key="Panel" Color="#111111"/>
        <SolidColorBrush x:Key="Panel2" Color="#151515"/>
        <SolidColorBrush x:Key="Panel3" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="Border" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Orange" Color="#FF7A00"/>
        <SolidColorBrush x:Key="OrangeLight" Color="#FF9A2E"/>
        <SolidColorBrush x:Key="OrangeDark" Color="#C85A00"/>
        <SolidColorBrush x:Key="Muted" Color="#A9AFB8"/>
        <SolidColorBrush x:Key="Green" Color="#14C767"/>
        <SolidColorBrush x:Key="Red" Color="#FF3152"/>
        <SolidColorBrush x:Key="Amber" Color="#FFC107"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8CDD5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202020"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7CCD4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#171717"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23170D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF9A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF8A18"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C85A00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#E7E9ED"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Bd" Property="Background" Value="#171717"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21170E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayChip" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#101215"/>
            <Setter Property="Foreground" Value="#C8CDD5"/>
            <Setter Property="BorderBrush" Value="#343A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="15" Height="15" CornerRadius="8" BorderBrush="#737A84" BorderThickness="2" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Chip" Property="Background" Value="#18130F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#4A2407"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Dot" Property="Background" Value="#FF7A00"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="#FF9A2E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighRiskChip" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="BorderBrush" Value="#78591A"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#422B08"/>
                    <Setter Property="BorderBrush" Value="#FFC107"/>
                    <Setter Property="Foreground" Value="#FFE08A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="SmallCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="#FF7A00"/>
            <Setter Property="Background" Value="#202020"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C85A00" BorderThickness="1" Background="#080808">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Compact native title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="#090909">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="M15,0 L6,14 L13,14 L8,28 L24,10 L16,10 Z" Fill="#FF7A00" Width="22" Height="28" Stretch="Fill" Margin="0,0,9,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Win-Slim Suite" FontWeight="Bold" FontSize="15" Foreground="White"/>
                        <TextBlock Text="Windows Optimization Suite" FontSize="9.5" Foreground="#9298A1" Margin="0,-1,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="24" Background="#4B2A12" Margin="16,0"/>
                    <TextBlock Text="FASE 7 · Native UI" FontSize="11" Foreground="#FF9A2E" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" Content="—"/>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Content="□"/>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Content="×"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#0A0A0A" BorderBrush="#242424" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,10,0,0">
                            <Button x:Name="NavInicio" Style="{StaticResource NavButton}" Tag="Dashboard">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="26"/><TextBlock Text="Início"/></StackPanel>
                            </Button>
                            <Button x:Name="NavPresets" Style="{StaticResource NavButton}" Tag="Presets">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Width="26"/><TextBlock Text="Presets"/></StackPanel>
                            </Button>
                            <Button x:Name="NavPersonalizado" Style="{StaticResource NavButton}" Tag="Custom">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="26"/><TextBlock Text="Personalizado"/></StackPanel>
                            </Button>
                            <Button x:Name="NavBackup" Style="{StaticResource NavButton}" Tag="Backup">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Width="26"/><TextBlock Text="Backup / Restore"/></StackPanel>
                            </Button>
                            <Button x:Name="NavAnalise" Style="{StaticResource NavButton}" Tag="Analysis">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Width="26"/><TextBlock Text="Análise do Sistema"/></StackPanel>
                            </Button>
                            <Button x:Name="NavConfiguracoes" Style="{StaticResource NavButton}" Tag="Settings">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="26"/><TextBlock Text="Configurações"/></StackPanel>
                            </Button>
                            <Button x:Name="NavSobre" Style="{StaticResource NavButton}" Tag="About">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Width="26"/><TextBlock Text="Sobre"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="10,0,10,10" Padding="9" Background="#0E0E0E" BorderBrush="#282828" BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock Text="NATIVE UI R3.2.1" Foreground="#FF9A2E" FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtBridgeState" Text="Conectando ao runtime..." Foreground="#8E949D" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content pages -->
                <Grid Grid.Column="1" x:Name="ContentHost" Background="#080808" ClipToBounds="True">

                    <!-- Dashboard prototype -->
                    <Grid x:Name="PageDashboard" Visibility="Collapsed" Margin="22,18,22,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Início — Dashboard" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="Visão geral do sistema e drive de ação principal." Foreground="#A9AFB8" FontSize="12" Margin="0,3,0,16"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="210"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="Bem-vindo ao Win-Slim Suite" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="Otimização segura do seu sistema em um só lugar." Foreground="#A9AFB8" FontSize="11" Margin="0,3,0,13"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Background="#0C0C0C" BorderBrush="#252525" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,8,0">
                                            <StackPanel><TextBlock x:Name="TxtDashWindows" Text="Windows 10/11" FontWeight="SemiBold"/><TextBlock x:Name="TxtDashCpu" Text="CPU · aguardando snapshot" Foreground="#959CA6" FontSize="10" Margin="0,4,0,0"/><TextBlock x:Name="TxtDashRam" Text="RAM · —" Foreground="#959CA6" FontSize="10"/></StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#0C0C0C" BorderBrush="#252525" BorderThickness="1" CornerRadius="7" Padding="12" Margin="8,0,0,0">
                                            <StackPanel><TextBlock x:Name="TxtDashGpu" Text="GPU · aguardando snapshot" FontWeight="SemiBold"/><TextBlock x:Name="TxtDashStorage" Text="Storage · —" Foreground="#959CA6" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="Backend aprovado: 230 tweaks" Foreground="#FF9A2E" FontSize="10"/></StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Status do Win-Slim" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Tweaks disponíveis" Foreground="#A9AFB8" Margin="0,15,0,0"/>
                                    <TextBlock x:Name="TxtDashTweaks" Text="230 / 230" HorizontalAlignment="Right" Margin="0,-17,0,0" FontWeight="SemiBold"/>
                                    <Separator Margin="0,9" Background="#2B2B2B"/>
                                    <TextBlock Text="Runtime" Foreground="#A9AFB8"/>
                                    <TextBlock Text="Planner / Transaction promovidos" Foreground="#14C767" HorizontalAlignment="Right" Margin="0,-17,0,0"/>
                                    <Separator Margin="0,9" Background="#2B2B2B"/>
                                    <TextBlock Text="Interface" Foreground="#A9AFB8"/>
                                    <TextBlock Text="C# WPF nativo" Foreground="#FF9A2E" HorizontalAlignment="Right" Margin="0,-17,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Desempenho atual" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Border Width="72" Height="72" CornerRadius="36" BorderBrush="#FF7A00" BorderThickness="2" Margin="0,0,20,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtMetricCpu" Text="—" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/><TextBlock Text="CPU" Foreground="#969CA5" HorizontalAlignment="Center" FontSize="9"/></StackPanel></Border>
                                            <Border Width="72" Height="72" CornerRadius="36" BorderBrush="#FF7A00" BorderThickness="2" Margin="0,0,20,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtMetricGpu" Text="—" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/><TextBlock Text="GPU" Foreground="#969CA5" HorizontalAlignment="Center" FontSize="9"/></StackPanel></Border>
                                            <Border Width="72" Height="72" CornerRadius="36" BorderBrush="#FF7A00" BorderThickness="2" Margin="0,0,20,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtMetricRam" Text="—" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/><TextBlock Text="RAM" Foreground="#969CA5" HorizontalAlignment="Center" FontSize="9"/></StackPanel></Border>
                                            <Border Width="72" Height="72" CornerRadius="36" BorderBrush="#FF7A00" BorderThickness="2"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtMetricDisk" Text="—" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/><TextBlock Text="DISCO" Foreground="#969CA5" HorizontalAlignment="Center" FontSize="9"/></StackPanel></Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="BtnDashAnalyze" Style="{StaticResource PrimaryButton}" Content="ANALISAR SISTEMA"/><Button x:Name="BtnDashPresets" Style="{StaticResource SecondaryButton}" Content="ESCOLHER PRESET" Margin="0,8,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- PRESETS: primary implemented screen -->
                    <Grid x:Name="PagePresets" Margin="20,15,20,14">
                        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="232"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Presets" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Escolha um perfil e combine overlays condicionais para o seu cenário." Foreground="#A9AFB8" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#101114" BorderBrush="#292C32" BorderThickness="1" CornerRadius="7" Padding="10,7" MaxWidth="365">
                                <TextBlock Text="Nenhuma alteração é aplicada nesta etapa. O runtime apenas resolve a seleção." Foreground="#A9AFB8" FontSize="10" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="CardPresetBalanced" Grid.Column="0" Background="#0C1410" BorderBrush="#1B7D49" BorderThickness="1.5" CornerRadius="9" Margin="0,0,8,0" Padding="15">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🌿" FontSize="28" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Equilibrado" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Estabilidade e responsividade para uso geral." Foreground="#A6B6AD" FontSize="10"/></StackPanel></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,8"><TextBlock Text="✓ Performance consistente" Foreground="#C8D3CD" Margin="0,2"/><TextBlock Text="✓ Privacidade moderada" Foreground="#C8D3CD" Margin="0,2"/><TextBlock Text="✓ Limpeza do sistema" Foreground="#C8D3CD" Margin="0,2"/><TextBlock Text="✓ Baixo risco" Foreground="#14C767" Margin="0,2"/></StackPanel>
                                    <Button x:Name="BtnPresetBalanced" Grid.Row="2" Style="{StaticResource PrimaryButton}" Background="#0EAE59" BorderBrush="#14C767" Content="Selecionar Equilibrado"/>
                                </Grid>
                            </Border>
                            <Border x:Name="CardPresetGamer" Grid.Column="1" Background="#16110C" BorderBrush="#6A3A14" BorderThickness="1.5" CornerRadius="9" Margin="4,0" Padding="15">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🎮" FontSize="28" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Gamer" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="FPS, latência, CPU/GPU, rede e energia." Foreground="#B7AAA0" FontSize="10"/></StackPanel></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,8"><TextBlock Text="✓ FPS / Latência" Foreground="#D1C7BF" Margin="0,2"/><TextBlock Text="✓ CPU e GPU" Foreground="#D1C7BF" Margin="0,2"/><TextBlock Text="✓ Rede e energia" Foreground="#D1C7BF" Margin="0,2"/><TextBlock Text="✓ Game Mode" Foreground="#FF9A2E" Margin="0,2"/></StackPanel>
                                    <Button x:Name="BtnPresetGamer" Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="Selecionar Gamer"/>
                                </Grid>
                            </Border>
                            <Border x:Name="CardPresetExtreme" Grid.Column="2" Background="#170B0E" BorderBrush="#743040" BorderThickness="1.5" CornerRadius="9" Margin="8,0,0,0" Padding="15">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🚀" FontSize="28" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Extremo" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Máximo desempenho com ajustes avançados." Foreground="#B8A1A7" FontSize="10"/></StackPanel></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,8"><TextBlock Text="✓ Menos recursos" Foreground="#D6C4C8" Margin="0,2"/><TextBlock Text="✓ Mais desempenho" Foreground="#D6C4C8" Margin="0,2"/><TextBlock Text="✓ Maior risco" Foreground="#FF7C90" Margin="0,2"/><TextBlock Text="✓ Alterações avançadas" Foreground="#D6C4C8" Margin="0,2"/></StackPanel>
                                    <Button x:Name="BtnPresetExtreme" Grid.Row="2" Style="{StaticResource PrimaryButton}" Background="#D91F40" BorderBrush="#FF3152" Content="Selecionar Extremo"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="246"/></Grid.ColumnDefinitions>
                            <Border Background="#0E0E0E" BorderBrush="#333333" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
