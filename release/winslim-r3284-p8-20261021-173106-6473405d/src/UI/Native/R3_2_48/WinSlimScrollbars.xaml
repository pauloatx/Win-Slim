<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WinSlimScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinSlimScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#FF7A00"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Border x:Name="RoundedThumb" Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RoundedThumb" Property="Background" Value="#FF9A2E"/></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="RoundedThumb" Property="Background" Value="#C85A00"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RoundedThumb" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="WinSlimVerticalScroll" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border Background="#191919" CornerRadius="6" Margin="2"/>
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource WinSlimScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource WinSlimScrollThumb}" MinHeight="24"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource WinSlimScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="WinSlimHorizontalScroll" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border Background="#191919" CornerRadius="6" Margin="2"/>
            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource WinSlimScrollPage}" Command="{x:Static ScrollBar.PageLeftCommand}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource WinSlimScrollThumb}" MinWidth="24"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource WinSlimScrollPage}" Command="{x:Static ScrollBar.PageRightCommand}"/></Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template" Value="{StaticResource WinSlimVerticalScroll}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template" Value="{StaticResource WinSlimHorizontalScroll}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
