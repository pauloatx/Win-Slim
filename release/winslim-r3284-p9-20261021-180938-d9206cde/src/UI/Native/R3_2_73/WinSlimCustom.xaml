<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="RootCustomWindow" Background="{DynamicResource ThemeBrush_080808}" Foreground="{DynamicResource ThemeBrush_F5F5F5}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg" Color="{DynamicResource ThemeColor_080808}"/>
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource ThemeColor_111111}"/>
        <SolidColorBrush x:Key="Panel2" Color="{DynamicResource ThemeColor_151515}"/>
        <SolidColorBrush x:Key="Panel3" Color="{DynamicResource ThemeColor_0D0D0D}"/>
        <SolidColorBrush x:Key="Border" Color="{DynamicResource ThemeColor_2A2A2A}"/>
        <SolidColorBrush x:Key="Orange" Color="{DynamicResource ThemeColor_FF7A00}"/>
        <SolidColorBrush x:Key="OrangeLight" Color="{DynamicResource ThemeColor_FF9A2E}"/>
        <SolidColorBrush x:Key="OrangeDark" Color="{DynamicResource ThemeColor_C85A00}"/>
        <SolidColorBrush x:Key="Muted" Color="{DynamicResource ThemeColor_A9AFB8}"/>
        <SolidColorBrush x:Key="Green" Color="{DynamicResource ThemeColor_14C767}"/>
        <SolidColorBrush x:Key="Red" Color="{DynamicResource ThemeColor_FF3152}"/>
        <SolidColorBrush x:Key="Amber" Color="{DynamicResource ThemeColor_FFC107}"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C8CDD5}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_202020}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_2A2A2A}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_C42B1C}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C7CCD4}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1"><Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_171717}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_23170D}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_FF7A00}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_FF8A18}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_C85A00}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_39BFC3}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="LinkBorder" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,2"><Grid>
                    <ContentPresenter/>
                <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeBrush_7CDADD}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_39BFC3}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_111111}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E7E9ED}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_3A3A3A}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_171717}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_21170E}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayChip" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_101215}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C8CDD5}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_343A42}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><Grid>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="15" Height="15" CornerRadius="8" BorderBrush="{DynamicResource ThemeBrush_737A84}" BorderThickness="2" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                            </Grid>
                        <Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ThemeBrush_18130F}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ThemeBrush_4A2407}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource ThemeBrush_FF7A00}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTintText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighRiskChip" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_78591A}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_422B08}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_FFC107}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FFE08A}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="SmallCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E5E7EB}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FF7A00}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_202020}"/>
        </Style>

        <Style x:Key="BackupRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_0C0F10}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_F5F5F5}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="BackupRowBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ThemeBrush_242B30}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="{DynamicResource ThemeBrush_21170E}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="{DynamicResource ThemeBrush_3A1E0B}"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF7A00}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BackupRowBorder" Property="BorderThickness" Value="1"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    
        <Style x:Key="CustomCategory" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="8,1"/><Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="CustomTweakSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="126"/><Setter Property="Height" Value="30"/><Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E5E7EB}"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="CustomSwitchFocus" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="2"><Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <ContentPresenter Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border x:Name="CustomSwitchTrack" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="{DynamicResource ThemeBrush_42474D}" BorderBrush="{DynamicResource ThemeBrush_747B84}" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="CustomSwitchThumb" Width="14" Height="14" Fill="{DynamicResource ThemeBrush_FFFFFF}" HorizontalAlignment="Left" Margin="2,0"/></Border>
                </Grid><Border x:Name="MotionGlow" Background="{DynamicResource ThemeBrush_FF9A2E}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CustomSwitchTrack" Property="Background" Value="{DynamicResource ThemeBrush_00C853}"/><Setter TargetName="CustomSwitchTrack" Property="BorderBrush" Value="{DynamicResource ThemeBrush_55DD91}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CustomSwitchTrack" Property="BorderBrush" Value="{DynamicResource ThemeBrush_55DD91}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CustomSwitchFocus" Property="BorderBrush" Value="{DynamicResource ThemeBrush_FF9A2E}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
</UserControl.Resources>
    <Border BorderThickness="0" Background="{DynamicResource ThemeBrush_080808}"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Grid x:Name="CustomTitleBar" Background="{DynamicResource ThemeBrush_090909}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><Path x:Name="CustomBrandMark" Data="F0 M34 2 C22 2 11 10 7 21 C9 21 12 20 15 18 C13 21 10 23 7 24 C7 28 8 31 11 33 C9 36 6 39 4 41 C3 42 5 44 6 43 C9 40 12 37 14 34 C20 33 25 29 29 23 C26 24 23 25 20 25 C24 23 28 21 31 18 C33 13 34 7 34 2 Z M11 33 C15 23 23 13 30 7 C24 15 18 25 13 34 Z" Fill="{DynamicResource ThemeAccent}" Width="22" Height="28" Stretch="Uniform" Margin="0,0,9,0"/><StackPanel><TextBlock Text="Win-Slim Suite" FontSize="15" FontWeight="Bold"/><TextBlock Text="Windows Optimization Suite" FontSize="9" Foreground="{DynamicResource ThemeBrush_A9AFB8}"/></StackPanel><Border BorderBrush="{DynamicResource ThemeBrush_3A2A19}" BorderThickness="1,0,0,0" Margin="18,0,0,0" Padding="16,0,0,0"><TextBlock Text="Seu Windows no seu melhor." Foreground="{DynamicResource ThemeBrush_FF9A2E}" FontSize="11" VerticalAlignment="Center"/></Border></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnCustomMinimize" Style="{StaticResource TitleBarButton}" Content="—" AutomationProperties.Name="Minimizar"/><Button x:Name="BtnCustomMaximize" Style="{StaticResource TitleBarButton}" Content="□" AutomationProperties.Name="Maximizar ou restaurar"/><Button x:Name="BtnCustomClose" Style="{StaticResource CloseButton}" Content="×" AutomationProperties.Name="Fechar Personalizado"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource ThemeBrush_2A2A2A}" BorderThickness="0,0,1,0" Background="{DynamicResource ThemeBrush_0B0B0B}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Categorias" Foreground="{DynamicResource ThemeBrush_FF9A2E}" FontWeight="SemiBold" FontSize="12" Margin="16,18,0,12"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CustomCategories"/></ScrollViewer>
                <Border Grid.Row="2" Background="{DynamicResource ThemeBrush_0E1012}" BorderBrush="{DynamicResource ThemeBrush_283039}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10"><StackPanel><TextBlock Text="Personalizado" Foreground="{DynamicResource ThemeBrush_FF9A2E}" FontWeight="SemiBold" FontSize="11"/><TextBlock x:Name="TxtCustomCategorySummary" Text="Carregando catálogo..." Foreground="{DynamicResource ThemeBrush_A9AFB8}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/><Button x:Name="BtnCustomSave" Style="{StaticResource SecondaryButton}" Content="Salvar preset" Height="28" Margin="0,10,0,0" ToolTip="Salva a seleção em um arquivo JSON para usar em outro PC."/><Button x:Name="BtnCustomImport" Style="{StaticResource SecondaryButton}" Content="Importar preset" Height="28" Margin="0,6,0,0" ToolTip="Carrega um preset salvo. Revise a compatibilidade antes de continuar."/><Button x:Name="BtnCustomBack" Background="{DynamicResource ThemeBrush_241A10}" BorderBrush="{DynamicResource ThemeBrush_8A5525}" Foreground="{DynamicResource ThemeBrush_FFC078}" Style="{StaticResource SecondaryButton}" Content="← Voltar" Height="28" Margin="0,10,0,0"/></StackPanel></Border>
            </Grid></Border>
            <Grid Grid.Column="1" Margin="18,16,18,12"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource ThemeBrush_0D1012}" BorderBrush="{DynamicResource ThemeBrush_30383F}" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="24" Foreground="{DynamicResource ThemeBrush_A9AFB8}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtCustomSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeBrush_F5F5F5}" CaretBrush="{DynamicResource ThemeBrush_FF9A2E}" VerticalContentAlignment="Center" FontSize="12" AutomationProperties.Name="Buscar tweak por nome, descrição ou ID"/>
                    <TextBlock x:Name="CustomSearchPlaceholder" Grid.Column="1" Text="Buscar tweak..." Foreground="{DynamicResource ThemeBrush_777E87}" VerticalAlignment="Center" Margin="4,0" IsHitTestVisible="False"/>
                    <Button x:Name="BtnCustomClearSearch" Grid.Column="2" Style="{StaticResource TitleBarButton}" Content="×" Width="30" Height="30" ToolTip="Limpar busca"/>
                </Grid></Border>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtCustomHeading" Text="Personalizar Tweaks" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TxtCustomCount" Text="Selecione uma categoria." Foreground="{DynamicResource ThemeBrush_A9AFB8}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BtnCustomEnableCategory" Style="{StaticResource SecondaryButton}" Content="Ativar todos da categoria" Height="30" Padding="12,0" Margin="8,0" ToolTip="Seleciona todos os ajustes desta categoria, inclusive os ocultos pela busca. Nenhuma alteração é aplicada agora."/><Button x:Name="BtnCustomDisableCategory" Style="{StaticResource SecondaryButton}" Content="Desativar todos da categoria" Height="30" Padding="12,0" Margin="0,0,8,0" ToolTip="Desmarca todos os ajustes desta categoria, inclusive os ocultos pela busca. Não desfaz alterações já aplicadas ao Windows."/></StackPanel></Grid>
                <Border Grid.Row="2" Background="{DynamicResource ThemeBrush_0B0E10}" BorderBrush="{DynamicResource ThemeBrush_283039}" BorderThickness="1" CornerRadius="6"><Grid>
                    <ScrollViewer x:Name="CustomRowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CustomRows"/></ScrollViewer>
                    <TextBlock x:Name="TxtCustomEmpty" Text="Carregando ajustes..." Foreground="{DynamicResource ThemeBrush_A9AFB8}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" MaxWidth="480" IsHitTestVisible="False"/>
                </Grid></Border>
                <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TxtCustomSelection" Text="0 selecionados" Foreground="{DynamicResource ThemeBrush_A9AFB8}" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCustomReset" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="↻  Restaurar padrão" Width="170" Margin="8,0" ToolTip="Recupera a seleção inicial do preset escolhido ou importado. Não altera o Windows."/>
                    <Button x:Name="BtnCustomApply" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Aplicar selecionados" Width="200" IsEnabled="False" ToolTip="Abre a pré-visualização da seleção personalizada. A execução permanece em demonstração nesta versão." ToolTipService.ShowOnDisabled="True"/>
                </Grid>
                <TextBlock Grid.Row="4" Text="Ativado significa selecionado · nenhuma alteração é aplicada ao Windows nesta etapa." Foreground="{DynamicResource ThemeBrush_FF9A2E}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2"><TextBlock x:Name="TxtCustomStatus" Text="Modo de seleção · consulta ao catálogo" Foreground="{DynamicResource ThemeBrush_666D76}" FontSize="9" Margin="10,0" VerticalAlignment="Center"/><TextBlock Text="Win-Slim Suite · R3.2.73" Foreground="{DynamicResource ThemeBrush_666D76}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"/></Grid>
    </Grid></Border>
</UserControl>