<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="RootCustomWindow" Background="#080808" Foreground="#F5F5F5" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg" Color="#080808"/>
        <SolidColorBrush x:Key="Panel" Color="#111111"/>
        <SolidColorBrush x:Key="Panel2" Color="#151515"/>
        <SolidColorBrush x:Key="Panel3" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="Border" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Orange" Color="#FF7A00"/>
        <SolidColorBrush x:Key="OrangeLight" Color="#FF9A2E"/>
        <SolidColorBrush x:Key="OrangeDark" Color="#C85A00"/>
        <SolidColorBrush x:Key="Muted" Color="#A9AFB8"/>
        <SolidColorBrush x:Key="Green" Color="#14C767"/>
        <SolidColorBrush x:Key="Red" Color="#FF3152"/>
        <SolidColorBrush x:Key="Amber" Color="#FFC107"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8CDD5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202020"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7CCD4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9A2E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#171717"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23170D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF9A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF8A18"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C85A00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#39BFC3"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="LinkBorder" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,2">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#7CDADD"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkBorder" Property="BorderBrush" Value="#39BFC3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#E7E9ED"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Bd" Property="Background" Value="#171717"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21170E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayChip" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#101215"/>
            <Setter Property="Foreground" Value="#C8CDD5"/>
            <Setter Property="BorderBrush" Value="#343A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="15" Height="15" CornerRadius="8" BorderBrush="#737A84" BorderThickness="2" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Chip" Property="Background" Value="#18130F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#4A2407"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Dot" Property="Background" Value="#FF7A00"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="#FF9A2E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighRiskChip" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="BorderBrush" Value="#78591A"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#422B08"/>
                    <Setter Property="BorderBrush" Value="#FFC107"/>
                    <Setter Property="Foreground" Value="#FFE08A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="SmallCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="#FF7A00"/>
            <Setter Property="Background" Value="#202020"/>
        </Style>

        <Style x:Key="BackupRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#0C0F10"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="BackupRowBorder" Background="{TemplateBinding Background}" BorderBrush="#242B30" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="#21170E"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="#3A1E0B"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="#FF7A00"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BackupRowBorder" Property="BorderThickness" Value="1"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="#FF9A2E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    
        <Style x:Key="CustomCategory" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="8,1"/><Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="CustomTweakSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="126"/><Setter Property="Height" Value="30"/><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="CustomSwitchFocus" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <ContentPresenter Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border x:Name="CustomSwitchTrack" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="#42474D" BorderBrush="#747B84" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="CustomSwitchThumb" Width="14" Height="14" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0"/></Border>
                </Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CustomSwitchTrack" Property="Background" Value="#00C853"/><Setter TargetName="CustomSwitchTrack" Property="BorderBrush" Value="#55DD91"/><Setter TargetName="CustomSwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CustomSwitchTrack" Property="BorderBrush" Value="#55DD91"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CustomSwitchFocus" Property="BorderBrush" Value="#FF9A2E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
</UserControl.Resources>
    <Border BorderBrush="#C85A00" BorderThickness="1" CornerRadius="7" Background="#080808"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Grid x:Name="CustomTitleBar" Background="#090909"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><Path Data="M15,0 L6,14 L13,14 L8,28 L24,10 L16,10 Z" Fill="#FF7A00" Width="22" Height="28" Stretch="Fill" Margin="0,0,9,0"/><StackPanel><TextBlock Text="Win-Slim Suite" FontSize="15" FontWeight="Bold"/><TextBlock Text="Windows Optimization Suite" FontSize="9" Foreground="#A9AFB8"/></StackPanel><Border BorderBrush="#3A2A19" BorderThickness="1,0,0,0" Margin="18,0,0,0" Padding="16,0,0,0"><TextBlock Text="Seu Windows no seu melhor." Foreground="#FF9A2E" FontSize="11" VerticalAlignment="Center"/></Border></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnCustomMinimize" Style="{StaticResource TitleBarButton}" Content="—" AutomationProperties.Name="Minimizar"/><Button x:Name="BtnCustomMaximize" Style="{StaticResource TitleBarButton}" Content="□" AutomationProperties.Name="Maximizar ou restaurar"/><Button x:Name="BtnCustomClose" Style="{StaticResource CloseButton}" Content="×" AutomationProperties.Name="Fechar Personalizado"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Background="#0B0B0B"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Categorias" Foreground="#FF9A2E" FontWeight="SemiBold" FontSize="12" Margin="16,18,0,12"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CustomCategories"/></ScrollViewer>
                <Border Grid.Row="2" Background="#0E1012" BorderBrush="#283039" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10"><StackPanel><TextBlock Text="Personalizado" Foreground="#FF9A2E" FontWeight="SemiBold" FontSize="11"/><TextBlock x:Name="TxtCustomCategorySummary" Text="Carregando catálogo..." Foreground="#A9AFB8" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/><Button x:Name="BtnCustomSave" Style="{StaticResource SecondaryButton}" Content="Salvar preset" Height="28" Margin="0,10,0,0" ToolTip="Salva a seleção em um arquivo JSON para usar em outro PC."/><Button x:Name="BtnCustomImport" Style="{StaticResource SecondaryButton}" Content="Importar preset" Height="28" Margin="0,6,0,0" ToolTip="Carrega um preset salvo. Revise a compatibilidade antes de continuar."/><Button x:Name="BtnCustomBack" Background="#241A10" BorderBrush="#8A5525" Foreground="#FFC078" Style="{StaticResource SecondaryButton}" Content="← Voltar" Height="28" Margin="0,10,0,0"/></StackPanel></Border>
            </Grid></Border>
            <Grid Grid.Column="1" Margin="18,16,18,12"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#0D1012" BorderBrush="#30383F" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="24" Foreground="#A9AFB8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtCustomSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F5F5F5" CaretBrush="#FF9A2E" VerticalContentAlignment="Center" FontSize="12" AutomationProperties.Name="Buscar tweak por nome, descrição ou ID"/>
                    <TextBlock x:Name="CustomSearchPlaceholder" Grid.Column="1" Text="Buscar tweak..." Foreground="#777E87" VerticalAlignment="Center" Margin="4,0" IsHitTestVisible="False"/>
                    <Button x:Name="BtnCustomClearSearch" Grid.Column="2" Style="{StaticResource TitleBarButton}" Content="×" Width="30" Height="30" ToolTip="Limpar busca"/>
                </Grid></Border>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtCustomHeading" Text="Personalizar Tweaks" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TxtCustomCount" Text="Selecione uma categoria." Foreground="#A9AFB8" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BtnCustomEnableCategory" Style="{StaticResource SecondaryButton}" Content="Ativar todos da categoria" Height="30" Padding="12,0" Margin="8,0" ToolTip="Seleciona todos os ajustes desta categoria, inclusive os ocultos pela busca. Nenhuma alteração é aplicada agora."/></StackPanel></Grid>
                <Border Grid.Row="2" Background="#0B0E10" BorderBrush="#283039" BorderThickness="1" CornerRadius="6"><Grid>
                    <ScrollViewer x:Name="CustomRowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CustomRows"/></ScrollViewer>
                    <TextBlock x:Name="TxtCustomEmpty" Text="Carregando ajustes..." Foreground="#A9AFB8" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" MaxWidth="480" IsHitTestVisible="False"/>
                </Grid></Border>
                <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TxtCustomSelection" Text="0 selecionados" Foreground="#A9AFB8" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCustomReset" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="↻  Restaurar padrão" Width="170" Margin="8,0" ToolTip="Recupera a seleção inicial do preset escolhido ou importado. Não altera o Windows."/>
                    <Button x:Name="BtnCustomApply" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Aplicar selecionados" Width="200" IsEnabled="False" ToolTip="Abre a pré-visualização da seleção personalizada. A execução permanece em demonstração nesta versão." ToolTipService.ShowOnDisabled="True"/>
                </Grid>
                <TextBlock Grid.Row="4" Text="Ativado significa selecionado · nenhuma alteração é aplicada ao Windows nesta etapa." Foreground="#FF9A2E" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2"><TextBlock x:Name="TxtCustomStatus" Text="Modo de seleção · consulta ao catálogo" Foreground="#666D76" FontSize="9" Margin="10,0" VerticalAlignment="Center"/><TextBlock Text="Win-Slim Suite · R3.2.37" Foreground="#666D76" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"/></Grid>
    </Grid></Border>
</UserControl>