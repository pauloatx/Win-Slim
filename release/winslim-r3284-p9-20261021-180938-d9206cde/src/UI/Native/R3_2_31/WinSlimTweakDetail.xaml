<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Win-Slim Suite — Detalhe do tweak" Width="1180" Height="760" MinWidth="1040" MinHeight="680" WindowStyle="None" ResizeMode="CanResize" Background="#080808" Foreground="#E5E7EB" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
<Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#080808"/>
        <SolidColorBrush x:Key="Panel" Color="#111111"/>
        <SolidColorBrush x:Key="Panel2" Color="#151515"/>
        <SolidColorBrush x:Key="Panel3" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="Border" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Orange" Color="#FF7A00"/>
        <SolidColorBrush x:Key="OrangeLight" Color="#FF9A2E"/>
        <SolidColorBrush x:Key="OrangeDark" Color="#C85A00"/>
        <SolidColorBrush x:Key="Muted" Color="#A9AFB8"/>
        <SolidColorBrush x:Key="Green" Color="#14C767"/>
        <SolidColorBrush x:Key="Red" Color="#FF3152"/>
        <SolidColorBrush x:Key="Amber" Color="#FFC107"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8CDD5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202020"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7CCD4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9A2E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#171717"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23170D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF9A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF8A18"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C85A00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#39BFC3"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="LinkBorder" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,2">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#7CDADD"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkBorder" Property="BorderBrush" Value="#39BFC3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#E7E9ED"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Bd" Property="Background" Value="#171717"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21170E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayChip" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#101215"/>
            <Setter Property="Foreground" Value="#C8CDD5"/>
            <Setter Property="BorderBrush" Value="#343A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="15" Height="15" CornerRadius="8" BorderBrush="#737A84" BorderThickness="2" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Chip" Property="Background" Value="#18130F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#4A2407"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Dot" Property="Background" Value="#FF7A00"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="#FF9A2E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighRiskChip" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="BorderBrush" Value="#78591A"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#422B08"/>
                    <Setter Property="BorderBrush" Value="#FFC107"/>
                    <Setter Property="Foreground" Value="#FFE08A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="ToggleButton" BasedOn="{StaticResource OverlayChip}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="SmallCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="#FF7A00"/>
            <Setter Property="Background" Value="#202020"/>
        </Style>

        <Style x:Key="BackupRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#0C0F10"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="BackupRowBorder" Background="{TemplateBinding Background}" BorderBrush="#242B30" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="#21170E"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="BackupRowBorder" Property="Background" Value="#3A1E0B"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="#FF7A00"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BackupRowBorder" Property="BorderThickness" Value="1"/><Setter TargetName="BackupRowBorder" Property="BorderBrush" Value="#FF9A2E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    
        <Style x:Key="CustomCategory" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="8,1"/><Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="CustomTweakSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="126"/><Setter Property="Height" Value="30"/><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="CustomSwitchFocus" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <ContentPresenter Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border x:Name="CustomSwitchTrack" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="#42474D" BorderBrush="#747B84" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="CustomSwitchThumb" Width="14" Height="14" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0"/></Border>
                </Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CustomSwitchTrack" Property="Background" Value="#00C853"/><Setter TargetName="CustomSwitchTrack" Property="BorderBrush" Value="#55DD91"/><Setter TargetName="CustomSwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CustomSwitchTrack" Property="BorderBrush" Value="#55DD91"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CustomSwitchFocus" Property="BorderBrush" Value="#FF9A2E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
</Window.Resources>
<Border BorderBrush="#C85A00" BorderThickness="1.5" CornerRadius="12" Background="#080808"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition/></Grid.RowDefinitions>
<Grid x:Name="TweakTitleBar" Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ϟ" Foreground="#FF7A00" FontSize="30" FontWeight="Bold"/><TextBlock Text="Win-Slim Suite" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnTweakMinimize" Style="{StaticResource TitleBarButton}" Content="—"/><Button x:Name="BtnTweakMaximize" Style="{StaticResource TitleBarButton}" Content="□"/><Button x:Name="BtnTweakClose" Style="{StaticResource CloseButton}" Content="×"/></StackPanel></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,10,24,20"><StackPanel MaxWidth="940" HorizontalAlignment="Stretch">
<Button x:Name="BtnTweakBack" Style="{StaticResource SecondaryButton}" Content="← Voltar" HorizontalAlignment="Left" Height="30" Padding="16,0" Background="#241A10" BorderBrush="#8A5525" Foreground="#FFC078" Margin="0,0,0,12" ToolTip="Voltar à tela anterior preservando sua seleção e posição."/>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#FF7A00" FontSize="28" Margin="0,0,10,0"/><TextBlock x:Name="TxtTweakName" Text="Detalhe do tweak" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="740"/></StackPanel><Border Background="#302200" BorderBrush="#9C6500" BorderThickness="1" CornerRadius="16" Padding="12,5" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock x:Name="TxtTweakBadge" Text="Ajuste do catálogo" Foreground="#FFC107" FontWeight="SemiBold" FontSize="12"/></Border></StackPanel><Border x:Name="TweakStateBadge" Grid.Column="1" Background="#052415" BorderBrush="#095D32" BorderThickness="1" CornerRadius="18" Padding="12,6" VerticalAlignment="Top" Margin="14,5,0,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="TweakStateDot" Fill="#00C853" Width="12" Height="12" VerticalAlignment="Center"/><TextBlock x:Name="TxtTweakState" Text="Ativo" Foreground="#36E493" Margin="8,0,0,0" FontWeight="SemiBold"/></StackPanel></Border></Grid>
<TextBlock x:Name="TxtTweakDescription" Text="Carregando informações do catálogo..." FontSize="16" Foreground="#C7CCD4" TextWrapping="Wrap" Margin="0,0,0,18"/>
<StackPanel x:Name="TweakMetadataRows"><Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="◐" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Risco:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="#C7CCD4"/><TextBlock x:Name="TxtTweakRisk" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="#FFC107" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="♟" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Reinício:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="#C7CCD4"/><TextBlock x:Name="TxtTweakRestart" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="#FFC107" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="↶" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Rollback:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="#C7CCD4"/><TextBlock x:Name="TxtTweakRollback" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="#78BDCF" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="◎" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Compatibilidade:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="#C7CCD4"/><TextBlock x:Name="TxtTweakCompatibility" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="#00C853" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="◇" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Hardware:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="#C7CCD4"/><TextBlock x:Name="TxtTweakHardware" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="#BCC8D2" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⊙" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Dependências:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="#C7CCD4"/><TextBlock x:Name="TxtTweakDependencies" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="#BCC8D2" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
<Grid MinHeight="33" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⊗" FontSize="19" VerticalAlignment="Center"/><TextBlock Text="Conflitos:" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Foreground="#C7CCD4"/><TextBlock x:Name="TxtTweakConflicts" Grid.Column="2" Text="Consultando..." FontSize="16" Foreground="#BCC8D2" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/></Grid>
</StackPanel>
<Border Background="#4B3105" BorderBrush="#B87900" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,16,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⚠" Foreground="#FFD54F" FontSize="27" VerticalAlignment="Center"/><TextBlock x:Name="TxtTweakWarning" Grid.Column="1" Text="Confira o risco e a compatibilidade antes de continuar." Foreground="#FFE6AC" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"/></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="BtnTweakUndo" Style="{StaticResource SecondaryButton}" Content="↶  Desfazer" Height="46" FontSize="16" BorderBrush="#826447" ToolTip="Retira este ajuste da seleção. Não restaura configurações do Windows nesta demonstração."/><Button x:Name="BtnTweakApply" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="ϟ  Aplicar" Height="46" FontSize="16" ToolTip="Seleciona o ajuste e abre sua pré-visualização. A execução permanece em demonstração."/></Grid>
<TextBlock x:Name="TxtTweakDetailStatus" Text="Ativo significa selecionado · ações em modo de demonstração · nenhuma alteração no Windows." Foreground="#FF9A2E" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></Grid></Border></Window>